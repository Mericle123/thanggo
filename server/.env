# ThangGo backend env
DATABASE_URL="file:./dev.db"
JWT_SECRET="thanggo-dev-secret-change-in-prod"
JWT_REFRESH_SECRET="thanggo-dev-refresh-secret-change-in-prod"
ACCESS_TTL="2h"
REFRESH_TTL="30d"
PORT=4000
# For production, swap DATABASE_URL to a Postgres URL and set provider="postgresql" in schema.prisma
